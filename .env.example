GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Fine-grained personal access token, scoped only to the repo(s) you list in
# ALLOWED_TARGET_REPOS below. Required scopes: Contents (Read and write),
# Pull requests (Read and write). Do not grant Actions or any org-wide scope.
GITHUB_TOKEN=

# Comma-separated "owner/repo" list. Empty (the default) means push/PR is refused for
# every repository -- this is the safety allowlist that must be set explicitly before
# the coding agent's commits can be pushed and opened as a draft PR anywhere.
ALLOWED_TARGET_REPOS=

WORKSPACE_ROOT=./data/repos
DB_PATH=./data/pr-engineer.db
FRONTEND_ORIGIN=http://localhost:5173
MAX_CONCURRENT_RUNS=2
TEST_TIMEOUT_SECONDS=300

# The deployment-wide DEFAULT AI provider, used by any user who hasn't configured their own
# AI settings under Profile -> AI Model in the app (see app/ai/). "ollama" (default, local,
# no API key, no per-token cost) or "gemini" (real API key from
# https://aistudio.google.com/apikey, real per-token cost, much more reliable native
# tool-calling than a small local model). A user's own saved settings always take priority
# over this -- it's the backward-compatible fallback for single-tenant/dev deployments.
LLM_PROVIDER=ollama

# Only used when LLM_PROVIDER=ollama. Requires Ollama running locally with OLLAMA_MODEL
# already pulled (e.g. `ollama pull qwen2.5-coder:7b`).
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Only used when LLM_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

CODING_AGENT_MAX_ITERATIONS=25
CODING_AGENT_TIMEOUT_SECONDS=1800

# Encrypts per-user AI provider API keys at rest (app/ai/crypto.py). Optional -- if unset,
# falls back to SESSION_SECRET so a working deployment doesn't need a brand-new secret
# provisioned just for this. Set it explicitly in production if you want AI credentials to
# be able to rotate independently of session signing (rotating either secret invalidates
# data encrypted/signed under the old value).
AI_ENCRYPTION_KEY=
